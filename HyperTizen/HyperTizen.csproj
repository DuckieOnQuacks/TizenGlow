<Project Sdk="Tizen.NET.Sdk/1.1.9">

  <!-- Property Group for .NET Core Project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen90</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="lib\" />
    <Folder Include="res\" />
  </ItemGroup>

  <!-- The service reports its version to HyperTizenUI. Take it from tizen-manifest.xml (the TPK's own
       version) so there is one place to bump; it ends up as the assembly's informational version. -->
  <Target Name="VersionFromManifest" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes">
    <XmlPeek XmlInputPath="tizen-manifest.xml" Query="/p:manifest/@version" Namespaces="&lt;Namespace Prefix='p' Uri='http://tizen.org/ns/packages' /&gt;">
      <Output TaskParameter="Result" PropertyName="ManifestVersion" />
    </XmlPeek>
    <PropertyGroup>
      <Version>$(ManifestVersion)</Version>
      <InformationalVersion>$(ManifestVersion)</InformationalVersion>
      <FileVersion>$(ManifestVersion).0</FileVersion>
      <AssemblyVersion>$(ManifestVersion).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Rssdp" Version="4.0.4" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
